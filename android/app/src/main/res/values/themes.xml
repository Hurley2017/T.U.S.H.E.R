<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tusher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tusher_primary</item>
        <item name="colorPrimaryVariant">@color/tusher_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/tusher_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/tusher_primary_dark</item>
    </style>

    <style name="Theme.Tusher.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Tusher.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.Tusher.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
